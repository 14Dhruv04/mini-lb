# Control-plane API Gateway endpoint (no trailing slash)
MINILB_API_BASE_URL=https://0zt92gohbe.execute-api.ap-south-1.amazonaws.com

# Operator/admin token. Used only by the Vite development proxy.
# Do NOT prefix this with VITE_ or it will be exposed to the browser.
MINILB_ADMIN_TOKEN=replace-with-your-existing-admin-token

# Local MiniLB admin API
MINILB_LOCAL_ADMIN_URL=http://127.0.0.1:9090
